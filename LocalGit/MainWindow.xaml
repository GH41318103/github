<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LocalGit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalGit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LocalGit">

    <Grid Background="#24292e">
        <Grid.RowDefinitions>
            <!-- Top Toolbar (頂部工具列) -->
            <RowDefinition Height="52"/>
            <!-- Main Content Area (主要內容區) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. 頂部工具列 ================= -->
        <Border Grid.Row="0" Background="#1f2428" BorderBrush="#1b1f23" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Padding="0">

                <!-- Current Repository 按鈕：移除外部 Margin，設定 Width 確保與下方對齊 -->
                <Button Background="Transparent" 
                        BorderThickness="0" 
                        Padding="20,0" 
                        Height="52"
                        CornerRadius="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left">

                    <!-- 修正後的 Grid 欄位設定 -->
                    <Grid Width="260">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 電腦圖標 -->
                        <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="16" Foreground="#959da5" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- 文字資訊 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Current repository" FontSize="11" Foreground="#959da5"/>
                            <TextBlock Text="github" FontSize="13" FontWeight="Bold" Foreground="#f6f8fa" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- 右側倒三角形 -->
                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Foreground="#959da5" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 分隔線 -->
                <AppBarSeparator Margin="4,12"/>

                <!-- Current Branch 按鈕 -->
                <Button Background="Transparent" 
                        BorderThickness="0" 
                        Padding="16,0" 
                        Height="52"
                        CornerRadius="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left">
                    <Grid Width="160">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 分支圖標 -->
                        <Viewbox Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Canvas Width="32" Height="32">
                                <!-- 圓圈 1 (左上)：直徑 8, 置於 (4, 4) -->
                                <Ellipse Width="8" Height="8" Canvas.Left="4" Canvas.Top="4" Stroke="#959da5" StrokeThickness="2.0"/>

                                <!-- 圓圈 2 (左下)：直徑 8, 置於 (4, 20) -->
                                <Ellipse Width="8" Height="8" Canvas.Left="4" Canvas.Top="20" Stroke="#959da5" StrokeThickness="2.0"/>

                                <!-- 圓圈 3 (右上)：直徑 8, 置於 (20, 4) -->
                                <Ellipse Width="8" Height="8" Canvas.Left="20" Canvas.Top="4" Stroke="#959da5" StrokeThickness="2.0"/>

                                <!-- 主幹線 (垂直連接左上與左下圓圈) -->
                                <Line X1="8" Y1="12" X2="8" Y2="20" Stroke="#959da5" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- 極致平滑分支曲線 (從主幹起點 (8, 16) 完美平滑延伸至右上 (24, 12)) -->
                                <Path Data="M 8,16 C 8,20 20,12 24,12" Stroke="#959da5" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Current branch" FontSize="11" Foreground="#959da5"/>
                            <TextBlock Text="main" FontSize="13" FontWeight="Bold" Foreground="#f6f8fa" Margin="0,1,0,0"/>
                        </StackPanel>

                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Foreground="#959da5" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 分隔線 -->
                <AppBarSeparator Margin="4,12"/>

                <!-- Publish Repository 按鈕 -->
                <Button Background="Transparent" 
                        BorderThickness="0" 
                        Padding="16,0" 
                        Height="52"
                        CornerRadius="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left">
                    <Grid Width="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 上傳圖標 -->
                        <FontIcon Grid.Column="0" Glyph="&#xE898;" FontSize="16" Foreground="#959da5" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Publish repository" FontSize="13" FontWeight="Bold" Foreground="#f6f8fa"/>
                            <TextBlock Text="Publish this repository to GitHub" FontSize="11" Foreground="#959da5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

            </StackPanel>
        </Border>

        <!-- ================= 2. 主要內容區 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左側面板寬度設定 300，與上方按鈕維持一致的視覺延伸 -->
                <ColumnDefinition Width="300" MinWidth="300" MaxWidth="500"/>
                <!-- 右側主畫布 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側欄：Tab 與列表 -->
            <Border Grid.Column="0" Background="#24292e" BorderBrush="#1b1f23" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab 欄位：寬度填滿，不留邊距 (Margin="0") -->
                    <Grid Grid.Row="0" Background="#1f2428" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Changes Tab 按鈕 (未選中狀態) -->
                        <Button Grid.Column="0" 
                                Background="#1f2428" 
                                BorderBrush="#1b1f23" 
                                BorderThickness="0,0,1,1"
                                CornerRadius="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Padding="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="Changes" Foreground="#959da5" FontSize="13" FontWeight="SemiBold"/>
                                <!-- 數量標籤 3.6k -->
                                <Border Background="#3f4448" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="3.6k" Foreground="#959da5" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- History Tab 按鈕 (當前選中狀態) -->
                        <Button Grid.Column="1" 
                                Background="#24292e" 
                                BorderBrush="#1b1f23" 
                                BorderThickness="0,0,0,1"
                                CornerRadius="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">

                            <!-- 使用 Grid 撐滿整個按鈕內部空間 -->
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                <!-- 文字獨立居中 -->
                                <TextBlock Text="History" 
                                           Foreground="#f6f8fa" 
                                           FontSize="13" 
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>

                                <!-- 藍色底線：設定為 Stretch 撐滿整顆 Button 的寬度 -->
                                <Border Height="3" 
                                        Background="#0366d6" 
                                        VerticalAlignment="Bottom" 
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Button>

                    </Grid>


                    <!-- 下方內容列表區 -->
                    <Grid Grid.Row="1" Background="#24292e">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="No history" Foreground="#6a737d" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右側主要畫布：空狀態插圖 -->
            <Grid Grid.Column="1" Background="#2b3137">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                    <!-- 提示文字 -->
                    <TextBlock Text="No commit selected" 
                               HorizontalAlignment="Center" 
                               Foreground="#6a737d" 
                               FontSize="14"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
